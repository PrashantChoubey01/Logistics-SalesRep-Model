# DP World × SeaRates AI - Environment Configuration
# Copy this file to .env and fill in your values

# ===========================================
# REQUIRED: Databricks Configuration
# ===========================================
# Your Databricks personal access token for Claude API access
DATABRICKS_TOKEN=your_databricks_token_here

# Databricks workspace host (default: adb-984752964297111.11.azuredatabricks.net)
DATABRICKS_HOST=adb-984752964297111.11.azuredatabricks.net

# ===========================================
# OPTIONAL: Direct API Keys (if not using Databricks)
# ===========================================
# Anthropic API key (only if using direct Anthropic API)
# ANTHROPIC_API_KEY=sk-ant-xxxxx

# OpenAI API key (only if using OpenAI models)
# OPENAI_API_KEY=sk-xxxxx

# ===========================================
# OPTIONAL: Server Configuration
# ===========================================
# API server port (default: 5001)
# API_PORT=5001

# Frontend server port (default: 5002)
# FRONTEND_PORT=5002

# Log level (DEBUG, INFO, WARNING, ERROR)
# LOG_LEVEL=INFO
